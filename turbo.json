{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "WEB_PORT",
        "GRAPH_NODE_PORT"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "//#test:tools": {
      "inputs": [
        "tools/**"
      ],
      "outputs": []
    },
    "check": {},
    "verify:abis": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "E2E_PORT"
      ]
    },
    "test:fork": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "MAINNET_RPC_URL",
        "ANVIL_PORT",
        "CLI_ANVIL_PORT",
        "FORK_PORT",
        "GITHUB_TOKEN"
      ]
    },
    "test:smoke:web": {
      "cache": false,
      "passThroughEnv": [
        "PRODUCTION_URL",
        "CI"
      ]
    },
    "test:parity": {
      "cache": false,
      "passThroughEnv": [
        "SUBGRAPH_URL_MAINNET",
        "SUBGRAPH_URL_GNOSIS",
        "GRAPH_NODE_PORT",
        "MAINNET_RPC_URL",
        "GNOSIS_RPC_URL",
        "GITHUB_TOKEN",
        "GH_TOKEN",
        "GITHUB_STEP_SUMMARY",
        "PARITY_STATE_DIR"
      ]
    },
    "lint": {},
    "@cobuilders/safenet-subgraph-gnosis#test": {
      "dependsOn": [
        "^build",
        "@cobuilders/safenet-subgraph-mainnet#test"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "@cobuilders/safenet-web#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.local",
        "$TURBO_ROOT$/.env.production",
        "$TURBO_ROOT$/.env.production.local"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@cobuilders/safenet-core#build": {
      "outputs": []
    },
    "bootstrap": {
      "cache": false
    },
    "@cobuilders/safenet-web#check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/subgraph-mainnet/schema.graphql",
        "$TURBO_ROOT$/packages/subgraph-gnosis/schema.graphql"
      ]
    }
  }
}
