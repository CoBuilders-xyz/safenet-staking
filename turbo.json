{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "WEB_PORT"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "check": {},
    "verify:abis": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "E2E_PORT"
      ]
    },
    "test:fork": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "MAINNET_RPC_URL",
        "ANVIL_PORT",
        "FORK_PORT",
        "GITHUB_TOKEN"
      ]
    },
    "test:parity": {
      "cache": false
    },
    "lint": {},
    "@cobuilders/safenet-subgraph-gnosis#test": {
      "dependsOn": [
        "^build",
        "@cobuilders/safenet-subgraph-mainnet#test"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "@cobuilders/safenet-core#build": {
      "outputs": []
    },
    "bootstrap": {
      "cache": false
    }
  }
}
