{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "check": {},
    "verify:abis": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:fork": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:parity": {
      "cache": false
    },
    "lint": {},
    "@cobuilders/safenet-core#build": {
      "outputs": []
    },
    "bootstrap": {
      "cache": false
    }
  }
}
