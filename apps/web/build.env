# Build-time values for the production bundle on IPFS.
#
# THIS FILE IS PUBLIC BY DESIGN. Every value here ends up in the JavaScript that anyone can
# download from IPFS, so it is committed and never holds a secret. A provider API key, a
# private RPC URL or a token here is a key given away for good: an IPFS release cannot be
# taken back.
#
# The release build (pnpm --filter @cobuilders/safenet-web release:build) reads this file and
# the explicit VITE_GRAPH_API_KEY environment input (COB-566). Other shell VITE_ values and
# all .env files are ignored. Supply the same public key when reproducing a release; this
# makes the CID reproducible from a clean clone. See VERIFY.md at the repository root.
#
# Only VITE_ keys are allowed. Values are unquoted, one per line.

# WalletConnect project id. Public: a project id is meant to ship in client code.
VITE_WALLETCONNECT_PROJECT_ID=f35bb4d915df109f8006841b674b5604

# Canonical URL for the og:image and twitter:image tags. Empty until the ENS name exists.
VITE_APP_URL=

# Validator list from the Safenet REST API (apps/api), served by the Worker on this custom domain.
# Its /v1/validators answers the bare array that useValidators reads. Unset, the list comes from
# SEF's published JSON. Cut a release only after this origin answers: the list has no fallback.
VITE_VALIDATOR_INFO_URL=https://api.safenet.cobuilders.xyz/v1/validators

# Alerts Worker (apps/alerts). Its APP_ORIGINS must list every origin that serves this build.
# Unset, the alerts route reports that alerts are not configured.
VITE_ALERTS_API_URL=https://alerts.safenet.cobuilders.xyz
