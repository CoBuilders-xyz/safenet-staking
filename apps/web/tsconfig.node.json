{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "vite.config.ts",
    "codegen.ts",
    "scripts/subgraph-api-schema.ts",
    "scripts/codegen-check.ts",
    "scripts/codegen-live-check.ts",
    "scripts/fork-env/*.ts",
    "scripts/release.ts",
    "scripts/release-pin.ts",
    "scripts/i18n-catalogues.ts",
    "scripts/i18n-extract.ts",
    "src/i18n/languages.ts",
    "scripts/budget.ts",
    "scripts/check-budget.ts",
    "scripts/lighthouse.ts",
    "scripts/availability.ts",
    "scripts/availability-checks.ts"
  ]
}
