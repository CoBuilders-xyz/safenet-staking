{
  "name": "@cobuilders/safenet-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "bootstrap": "echo '@cobuilders/safenet-web ready'",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "release:build": "tsx scripts/release.ts",
    "release:pin": "node --env-file-if-exists=../../.env.local --import tsx scripts/release-pin.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "pnpm codegen:check && eslint . && tsc -b --noEmit && tsc -p e2e/tsconfig.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:fork": "E2E_SUITE=fork playwright test --config e2e/playwright.config.ts",
    "fork:up": "node --import tsx scripts/fork-env/up.ts",
    "fork:reset": "node --import tsx scripts/fork-env/reset.ts",
    "fork:down": "node --import tsx scripts/fork-env/down.ts",
    "generate:proofs": "tsx scripts/generate-merkle-tree.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "tsx scripts/codegen-check.ts",
    "codegen:live-check": "tsx scripts/codegen-live-check.ts"
  },
  "dependencies": {
    "@cobuilders/safenet-core": "workspace:*",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@plausible-analytics/tracker": "0.4.6",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "@walletconnect/ethereum-provider": "2.26.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "17.0.2",
    "graphql-request": "7.4.0",
    "lucide-react": "1.61.0",
    "ox": "1.8.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "viem": "2.57.11",
    "wagmi": "3.7.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@graphql-codegen/add": "7.1.1",
    "@graphql-codegen/cli": "7.4.3",
    "@graphql-codegen/typed-document-node": "7.1.1",
    "@graphql-codegen/typescript-operations": "6.1.9",
    "@ipld/unixfs": "3.0.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-basic-ssl": "2.1.4",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "ipfs-car": "3.1.0",
    "jsdom": "28.1.0",
    "multiformats": "13.4.2",
    "pinata": "2.5.5",
    "tailwindcss": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
