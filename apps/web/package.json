{
  "name": "@cobuilders/safenet-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "bootstrap": "echo '@cobuilders/safenet-web ready'",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "release:build": "tsx scripts/release.ts",
    "budget:bundle": "tsx scripts/check-budget.ts",
    "budget:lighthouse": "tsx scripts/lighthouse.ts",
    "release:pin": "node --env-file-if-exists=../../.env.local --import tsx scripts/release-pin.ts",
    "availability": "tsx scripts/availability.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "pnpm codegen:check && pnpm i18n:check && eslint . && tsc -b --noEmit && tsc -p e2e/tsconfig.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:fork": "E2E_SUITE=fork playwright test --config e2e/playwright.config.ts",
    "test:smoke:web": "E2E_SUITE=smoke playwright test --config e2e/playwright.config.ts",
    "fork:up": "node --import tsx scripts/fork-env/up.ts",
    "fork:reset": "node --import tsx scripts/fork-env/reset.ts",
    "fork:down": "node --import tsx scripts/fork-env/down.ts",
    "generate:proofs": "tsx scripts/generate-merkle-tree.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "tsx scripts/codegen-check.ts",
    "codegen:live-check": "tsx scripts/codegen-live-check.ts",
    "i18n:extract": "tsx scripts/i18n-extract.ts",
    "i18n:check": "tsx scripts/i18n-extract.ts --check"
  },
  "dependencies": {
    "@cobuilders/safenet-core": "workspace:*",
    "@fontsource-variable/dm-sans": "5.2.8",
    "@fontsource-variable/geist-mono": "5.2.7",
    "@graphql-typed-document-node/core": "3.2.0",
    "@plausible-analytics/tracker": "0.4.4",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.90.21",
    "@walletconnect/ethereum-provider": "2.23.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "16.14.2",
    "graphql-request": "7.4.0",
    "i18next": "26.4.7",
    "lucide-react": "0.563.0",
    "ox": "0.12.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "17.0.20",
    "react-router-dom": "7.18.2",
    "recharts": "3.7.0",
    "tailwind-merge": "3.5.0",
    "viem": "2.46.2",
    "wagmi": "3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cobuilders/safenet-snapshots": "workspace:*",
    "@eslint/js": "9.39.2",
    "@graphql-codegen/add": "7.1.1",
    "@graphql-codegen/cli": "7.4.3",
    "@graphql-codegen/typed-document-node": "7.1.1",
    "@graphql-codegen/typescript-operations": "6.1.9",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-basic-ssl": "2.1.4",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "ipfs-car": "3.1.0",
    "jsdom": "28.1.0",
    "multiformats": "13.4.2",
    "tailwindcss": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
