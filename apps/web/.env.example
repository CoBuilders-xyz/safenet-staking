# All optional. Addresses, chain, scan floor and RPC endpoints come from
# @cobuilders/safenet-core, which defaults to Mainnet.
#
# For Sepolia there is no need to write a file: `pnpm dev:sepolia` sets what follows.
#
# VITE_CHAIN_ID=11155111
# VITE_STAKING_DEPLOY_BLOCK=10225303

# Optional - RPC endpoints, tried in this order.
#
# NEVER PUT A KEY HERE. Vite writes every VITE_ value into the file this app ships to
# IPFS. That file is public and permanent. An Alchemy or Infura key in these variables
# is a key you have given away. Keep private endpoints in .env.local at the repository
# root, where only the Node scripts read them.
#
# Setting any one of these REPLACES the built-in list. It does not extend it.
#
# VITE_RPC_URL=
# VITE_RPC_URL_FALLBACK_1=
# VITE_RPC_URL_FALLBACK_2=

# Optional — wallet connection
VITE_WALLETCONNECT_PROJECT_ID=

# Optional — Merkle drop rewards contract address
VITE_MERKLE_DROP_ADDRESS=

# Optional — compliance
VITE_SANCTIONS_API_URL=
VITE_GEOBLOCK_CACHE_DAYS=

# Optional — validator info endpoint (defaults to GitHub raw URL)
VITE_VALIDATOR_INFO_URL=

# Optional — rewards base URL (defaults to GitHub raw URL)
VITE_REWARDS_BASE_URL=

# Optional — analytics (Plausible); set to your site domain to enable tracking
VITE_PLAUSIBLE_DOMAIN=

# Optional — canonical app URL for social preview meta tags (og:image, twitter:image); absolute URLs are required for social crawlers
VITE_APP_URL=

# Optional — footer links
VITE_DOCS_URL=
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_IMPRINT_URL=

# IPFS deployment (used by `yarn deploy:ipfs`)
PINATA_JWT=
PINATA_GATEWAY=
