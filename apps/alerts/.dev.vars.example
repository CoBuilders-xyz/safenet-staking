# Local values for `pnpm --filter @cobuilders/safenet-alerts dev`. Copy to .dev.vars, which git ignores.
# Never put a real credential in this example file.

# Comma-separated exact browser origins: scheme, host and optional port. No path, no wildcard.
# Plain http only for localhost and 127.0.0.1.
APP_ORIGINS=http://localhost:5173,https://safenet.cobuilders.eth.limo,https://safenet.cobuilders.xyz
# Legacy single origin. Optional; merged with APP_ORIGINS when both are set.
# APP_ORIGIN=

# The DB binding is a local D1 database; it needs no value here.
# Other bindings, described in README.md. Uncomment and set the ones you need.
# MAINNET_RPC_URL=
# GNOSIS_RPC_URL=
# SUBGRAPH_URL_MAINNET=
# REWARDS_BASE_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_NAME=
# 32 to 256 characters of A-Z, a-z, 0-9, _ and -. Telegram sends it with every webhook request.
# TELEGRAM_WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
