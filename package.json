{
  "name": "safenet-staking",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "bootstrap": "bash scripts/setup.sh",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check": "pnpm lint && turbo run check",
    "verify:abis": "turbo run verify:abis",
    "verify:abis:deep": "node --env-file-if-exists=.env.local --import tsx packages/core/scripts/verify-abis.ts --deep",
    "test:e2e": "node tools/require-task.mjs test:e2e \"apps/web\" && turbo run test:e2e",
    "test:fork": "node tools/require-task.mjs test:fork \"apps/web and packages/cli\" && turbo run test:fork",
    "test:parity": "node tools/require-task.mjs test:parity \"the subgraph packages\" && turbo run test:parity",
    "spec:check": "node tools/spec-check.mjs",
    "check:browser": "node tools/check-browser-safety.mjs",
    "metrics": "pnpm --filter @cobuilders/safenet-core metrics && node tools/build-web-snapshot.mjs",
    "lint": "eslint . && turbo run lint"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "tsx": "4.21.0",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0"
  },
  "pnpm": {
    "overrides": {
      "@reown/appkit": "1.8.18"
    }
  }
}
