{
  "name": "safenet-staking",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "bootstrap": "bash scripts/setup.sh",
    "link:services": "bash scripts/link-services.sh",
    "env:pull": "bash scripts/pull-env.sh",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test test:tools",
    "test:tools": "node tools/run-node-tests.mjs tools/__tests__",
    "test:coverage": "turbo run test:coverage --filter=@cobuilders/safenet-cli --filter=@cobuilders/safenet-mcp",
    "check": "pnpm lint && pnpm check:browser && turbo run check",
    "verify:abis": "turbo run verify:abis",
    "verify:abis:deep": "node --env-file-if-exists=.env.local --import tsx packages/core/scripts/verify-abis.ts --deep",
    "test:e2e": "node tools/require-task.mjs test:e2e \"apps/web\" && turbo run test:e2e",
    "test:fork": "turbo run test:fork",
    "test:parity": "turbo run test:parity --continue",
    "check:browser": "node tools/check-browser-safety.mjs",
    "metrics": "pnpm --filter @cobuilders/safenet-core metrics",
    "test:smoke": "pnpm --filter @cobuilders/safenet-cli --filter @cobuilders/safenet-mcp test:smoke",
    "test:smoke:web": "node tools/require-task.mjs test:smoke:web \"apps/web\" && turbo run test:smoke:web",
    "lint": "eslint . && turbo run lint",
    "graph:up": "docker compose --profile graph --env-file .env.ports --env-file .env.local up -d",
    "graph:down": "docker compose --profile graph --env-file .env.ports --env-file .env.local down -v",
    "graph:logs": "docker compose --profile graph --env-file .env.ports --env-file .env.local logs -f graph-node | sed -E 's#https?://[^ ]+#<redacted-url>#g'",
    "fork:up": "pnpm --filter @cobuilders/safenet-web fork:up",
    "fork:reset": "pnpm --filter @cobuilders/safenet-web fork:reset",
    "fork:down": "pnpm --filter @cobuilders/safenet-web fork:down"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0"
  },
  "pnpm": {
    "overrides": {
      "@reown/appkit": "1.8.18",
      "viem@2.46.2>ws": "8.21.0",
      "@graphprotocol/graph-cli@0.98.1>glob": "11.1.0",
      "@graphprotocol/graph-cli@0.98.1>immutable": "5.1.8",
      "@graphprotocol/graph-cli@0.98.1>jayson": "5.0.0",
      "@graphprotocol/graph-cli@0.98.1>js-yaml": "4.3.2",
      "@graphprotocol/graph-cli@0.98.1>undici": "7.29.1",
      "@graphprotocol/graph-cli@0.98.1>yaml": "2.8.4",
      "gluegun@5.2.0>cross-spawn": "7.0.5",
      "gluegun@5.2.0>ejs": "3.1.10",
      "gluegun@5.2.0>semver": "7.5.2",
      "apisauce@2.1.6>axios": "0.34.0",
      "tsup@8.5.1>esbuild": "0.28.2",
      "@graphql-tools/utils@^11": "12.0.3"
    }
  }
}
