{
  "name": "@cobuilders/safenet-subgraph-mainnet",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "bootstrap": "echo '@cobuilders/safenet-subgraph-mainnet ready'",
    "generate": "tsx scripts/generate-manifest.ts",
    "dev": "pnpm generate && graph codegen",
    "build": "pnpm generate && graph codegen && graph build",
    "test": "pnpm generate && graph codegen && graph test -v 0.6.0",
    "check": "eslint . && tsc --noEmit -p tsconfig.check.json",
    "deploy:studio": "pnpm build && node --env-file-if-exists=../../.env.local ../../tools/deploy-studio.mjs safenet-mainnet",
    "differential": "node --env-file-if-exists=../../.env.ports --env-file-if-exists=../../.env.local --import tsx scripts/differential.ts",
    "test:parity": "node --env-file-if-exists=../../.env.ports --env-file-if-exists=../../.env.local --import tsx scripts/parity.ts"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2"
  },
  "devDependencies": {
    "@cobuilders/safenet-core": "workspace:*",
    "@types/node": "22.19.2",
    "assemblyscript": "0.19.23",
    "matchstick-as": "0.6.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "viem": "2.57.7"
  }
}
