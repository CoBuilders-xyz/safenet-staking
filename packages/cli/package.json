{
  "name": "@cobuilders/safenet-cli",
  "version": "0.0.0",
  "type": "module",
  "description": "safenet, a command-line interface for Safenet: reads, and stake, unstake and claims with --dry-run.",
  "license": "MIT",
  "keywords": [
    "cli",
    "safenet",
    "safe",
    "staking",
    "ethereum"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoBuilders-xyz/safenet-staking.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "safenet": "./dist/index.js"
  },
  "exports": {
    "./lib": {
      "source": "./src/lib/index.ts",
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./program": {
      "source": "./src/cli.ts",
      "types": "./dist/program.d.ts",
      "import": "./dist/program.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bootstrap": "echo '@cobuilders/safenet-cli: nothing to prepare'",
    "dev": "tsc --noEmit --watch",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env.local --import tsx src/index.ts",
    "test": "node ../../tools/run-node-tests.mjs src",
    "test:smoke": "node --env-file-if-exists=../../.env.local ../../tools/run-node-tests.mjs src/smoke",
    "test:fork": "SAFENET_FORK_SUITE=1 node --env-file-if-exists=../../.env.local ../../tools/run-node-tests.mjs src/fork",
    "check": "pnpm lint && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "commander": "15.0.0",
    "viem": "2.46.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cobuilders/safenet-core": "workspace:*",
    "@types/node": "26.6.5",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
